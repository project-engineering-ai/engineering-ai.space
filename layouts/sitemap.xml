{{- /* ===================================================================
       sitemap.xml — тот же формат, что был у прежней версии сайта:
       <url> с hreflang-альтернативами (xmlns:xhtml).

       Шаблон переопределяет встроенный и применяется К КАЖДОМУ языку,
       поэтому получаются /ru/sitemap.xml и /en/sitemap.xml, а корневой
       /sitemap.xml остаётся индексом. В robots.txt указан индекс — так
       обе языковые карты попадают в обход автоматически.

       Важно: home и section НЕ входят в site.RegularPages, поэтому фильтр
       идёт по site.Pages с ограничением по Kind — иначе карта пустая.
       =================================================================== */ -}}
{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{{- $site := strings.TrimSuffix "/" site.BaseURL -}}
{{- $pages := where site.Pages "Kind" "in" (slice "home" "section" "page") -}}
{{- range $pages }}
  {{- if not .Params.private }}
  {{- $p := .RelPermalink -}}
  {{- $base := $p -}}
  {{- if eq site.Language.Lang "en" }}{{ $base = strings.TrimPrefix "/en" $p }}{{ end -}}
  {{- if eq $base "" }}{{ $base = "/" }}{{ end -}}
  {{- $urlRu := "" }}{{ $urlEn := "" -}}
  {{- if eq $base "/" -}}
    {{- $urlRu = printf "%s/" $site -}}{{- $urlEn = printf "%s/en/" $site -}}
  {{- else -}}
    {{- $urlRu = printf "%s%s" $site $base -}}{{- $urlEn = printf "%s/en%s" $site $base -}}
  {{- end }}
  <url>
    <loc>{{ .Permalink }}</loc>
    <xhtml:link rel="alternate" hreflang="ru" href="{{ $urlRu }}" />
    <xhtml:link rel="alternate" hreflang="en" href="{{ $urlEn }}" />
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ $urlRu }}" />
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02" }}</lastmod>
    {{- end }}
    <changefreq>weekly</changefreq>
    <priority>{{ if .IsHome }}1.0{{ else }}0.7{{ end }}</priority>
  </url>
  {{- end }}
{{- end }}
</urlset>
